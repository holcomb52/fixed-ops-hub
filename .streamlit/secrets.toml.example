# Copy to .streamlit/secrets.toml for local dev
# On Streamlit Cloud: App settings → Secrets

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "your_service_role_key"

# Required for cloud — protects payroll and warranty data
APP_PASSWORD = "choose-a-strong-password"

# Parts Manager — Parts tab + Parts Returns / Stocking reports only
PARTS_MANAGER_PASSWORD = "choose-a-strong-parts-password"
PARTS_MANAGER_LABEL = "Parts Manager"

# Warranty Audit page only. Leave blank to keep the rest of the app unchanged.
# The model must accept images (gpt-4o does). Never commit a real key.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o"
